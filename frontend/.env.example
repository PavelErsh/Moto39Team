# -----------------------------------------------------------------------------
# Веб-сборка (браузер / фронт за nginx)
# -----------------------------------------------------------------------------
# По умолчанию фронт использует относительный путь /api/v1 и Vite-прокси
# (см. vite.config.ts). Это позволяет тестировать сайт с телефона по HTTPS
# на IP-адресе, а GPS работает только на secure origin.
# Раскомментируйте, только если хотите принудительно ходить на другой хост.
# VITE_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Нативная сборка Capacitor (Android/iOS)
# -----------------------------------------------------------------------------
# В нативной обёртке фронт открывается с capacitor://localhost, поэтому
# относительный `/api/v1` работать не будет. Обязательно укажите публичный
# URL продового API — с ним же будет общаться и фоновый трекер геолокации.
# Пример:
# VITE_API_URL=https://moto39team.ru/api/v1

# Ключ Яндекс.Карт (JS API v2.1). Регистрация: https://developer.tech.yandex.ru/
# Если оставить пустым — на странице «Карта» будет использоваться
# бесплатный движок Leaflet + OpenStreetMap (без ключа).
VITE_YANDEX_MAPS_API_KEY=
