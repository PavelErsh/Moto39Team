# Application
APP_NAME=Moto39Team
APP_ENV=development
DEBUG=True

# Database
# For local dev with SQLite:
DATABASE_URL=sqlite+aiosqlite:///./app.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moto39team

# JWT
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
# Список origin через запятую. Оставьте пустым, чтобы использовать значение по умолчанию
# (все локальные порты Vite: 5173/5174/5175 + 4173).
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Регулярка (по умолчанию разрешает любой localhost/127.0.0.1 с любым портом):
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

