# Application
APP_NAME=Moto39Team
APP_ENV=development
DEBUG=True

# Database
# For local dev with SQLite:
DATABASE_URL=sqlite+aiosqlite:///./app.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moto39team

# JWT
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
# Список origin через запятую. Оставьте пустым, чтобы использовать значение по умолчанию
# (все локальные порты Vite: 5173/5174/5175 + 4173).
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Регулярка (по умолчанию разрешает любой localhost/127.0.0.1 с любым портом):
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# -----------------------------------------------------------------------------
# Верификация e-mail при регистрации
# -----------------------------------------------------------------------------
# True — на /auth/register отправляется код на email; аккаунт создаётся
# только после /auth/verify-email. False — регистрация мгновенная.
EMAIL_VERIFICATION_ENABLED=True
EMAIL_CODE_LENGTH=6
EMAIL_CODE_TTL_MINUTES=15
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_INTERVAL_SECONDS=60

# SMTP-параметры. Ниже — готовые пресеты популярных провайдеров.
# Раскомментируйте одну секцию (свою) и заполните USERNAME/PASSWORD.
#
# --------- Gmail (рекомендуется для личной почты) ---------
# 1) Включите 2-Factor Authentication:
#      https://myaccount.google.com/security
# 2) Создайте "App password" (пароль приложения) для этого сервера:
#      https://myaccount.google.com/apppasswords
#    Google выдаст 16-значный код вида "abcd efgh ijkl mnop" — это и есть
#    ваш SMTP_PASSWORD (пробелы можно убрать).
# 3) Заполните:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=False
# SMTP_USE_STARTTLS=True
# SMTP_USERNAME=your.name@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx        # 16-значный app password
# SMTP_FROM_EMAIL=your.name@gmail.com   # ДОЛЖЕН совпадать с USERNAME
# SMTP_FROM_NAME=Moto39Team
#
# --------- Yandex ---------
# 1) Включите пароли для приложений: id.yandex.ru → «Пароли и авторизация»
# 2) SMTP_PASSWORD = сгенерированный пароль приложения (не пароль от почты).
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465                         # для 465 — SMTP_USE_TLS=True, STARTTLS=False
# SMTP_USE_TLS=True
# SMTP_USE_STARTTLS=False
# SMTP_USERNAME=your.name@yandex.ru
# SMTP_PASSWORD=<app_password>
# SMTP_FROM_EMAIL=your.name@yandex.ru
# SMTP_FROM_NAME=Moto39Team
#
# --------- Mail.ru ---------
# 1) account.mail.ru → «Пароли для внешних приложений» → создать.
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USE_TLS=True
# SMTP_USE_STARTTLS=False
# SMTP_USERNAME=your.name@mail.ru
# SMTP_PASSWORD=<app_password>
# SMTP_FROM_EMAIL=your.name@mail.ru
# SMTP_FROM_NAME=Moto39Team
#
# Активные переменные (по умолчанию — Gmail-совместимый STARTTLS/587):
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=False
SMTP_USE_STARTTLS=True
# Адрес и имя, которые получатель увидит в поле "From".
# Важно: SMTP_FROM_EMAIL ДОЛЖЕН совпадать с SMTP_USERNAME (иначе Gmail/Yandex/
# Mail.ru отклонят письмо с "sender rejected" / "authentication mismatch").
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Moto39Team
# Если SMTP не настроен и EMAIL_CONSOLE_FALLBACK=True — код печатается
# в лог backend'а (удобно для локальной разработки без реального почтового
# сервера). На продакшене — рекомендую оставить True как safety-net: если
# SMTP внезапно упадёт, регистрация не сломается, а код можно посмотреть в
# `docker logs moto39team-api`.
EMAIL_CONSOLE_FALLBACK=True


# -----------------------------------------------------------------------------
# Cloudflare Turnstile (капча на регистрации)
# -----------------------------------------------------------------------------
# Регистрация ключей: https://dash.cloudflare.com/?to=/:account/turnstile
# Site key виден фронту (через /api/v1/auth/config), secret хранится только на бэке.
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
