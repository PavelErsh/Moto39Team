# =========================================================================
# Конфигурация деплоя Moto39Team.
#
# Скопируйте этот файл в deploy/deploy.env (он в .gitignore) и заполните:
#     cp deploy/env.example deploy/deploy.env
#     nano deploy/deploy.env
#
# После этого команду `make deploy` (или ./deploy/deploy.sh) можно запускать
# со своей локальной машины — она сама зайдёт на сервер по SSH, обновит код
# и пересоберёт всё что нужно.
# =========================================================================

# --- Куда деплоим ---
# IP или доменное имя вашего сервера.
SERVER_HOST=your-server-ip-or-hostname

# SSH-пользователь на сервере. Обычно "deploy" или "root".
SERVER_USER=deploy

# SSH-порт (стандартный 22, если не меняли).
SERVER_PORT=22

# Полный путь к каталогу проекта НА СЕРВЕРЕ.
# При первом запуске setup-server.sh сам склонирует репозиторий сюда.
SERVER_PROJECT_DIR=/var/www/Moto39Team

# --- Репозиторий (используется setup-server.sh при первичной установке) ---
GIT_REPO=https://github.com/PavelErsh/Moto39Team.git
GIT_BRANCH=main

# --- Домен и HTTPS ---
# Основной домен (без https:// и без слэша).
DOMAIN=your-domain.ru
# www-версия (опционально, оставьте пустым, если не нужна).
DOMAIN_WWW=www.your-domain.ru
# Email для Let's Encrypt (для важных уведомлений о продлении).
LETSENCRYPT_EMAIL=admin@your-domain.ru
