# =========================================================================
# Nginx-конфиг для Moto39Team.
#
# Плейсхолдеры __DOMAIN__ / __DOMAIN_WWW__ / __PROJECT_DIR__ подставляются
# скриптом deploy/setup-server.sh при установке. Итоговый файл кладётся в
# /etc/nginx/sites-available/moto39team и симлинкается в sites-enabled.
#
# HTTPS/редирект на 443 добавит certbot --nginx (см. setup-server.sh и
# deploy/update.sh — там при каждом обновлении вызывается certbot --nginx,
# чтобы ре-установить SSL после регенерации конфига из шаблона).
# =========================================================================

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ __DOMAIN_WWW__;

    # Явно подключаем MIME-типы (без этого nginx на некоторых сборках
    # отдаёт .js как text/plain → браузер отклоняет module-script).
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Добавляем только те типы, которых может не быть в стандартном
    # /etc/nginx/mime.types (на Ubuntu их обычно нет).
    # Все остальные (js/css/svg/json/woff/woff2/…) уже определены выше —
    # передекларировать их нельзя, иначе nginx пишет:
    #   "duplicate extension <ext>, content type: …".
    types {
        application/wasm          wasm;
        application/manifest+json webmanifest;
        application/javascript    mjs;
    }

    # webroot для валидации Let's Encrypt (используется certbot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    root __PROJECT_DIR__/frontend/dist;
    index index.html;

    # Разрешаем загружать изображения справочника до ~20 МБ.
    client_max_body_size 20m;

    # ── React SPA (history mode) ────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── FastAPI ──────────────────────────────────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;

        # WebSocket-поддержка (чат)
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
    }

    # ── Загруженные файлы (uploads/) ─────────────────────────────
    #
    # Важно: используем префикс `^~`, чтобы этот location имел
    # приоритет над regex-локацией `\.(jpg|jpeg|png|...)$` ниже.
    # Без `^~` nginx выбирает regex-локацию для файлов вида
    # /media/events/xxxx.jpeg, пытается найти их в frontend/dist
    # и отдаёт 404 (собственно та ошибка, которую видит браузер).
    location ^~ /media/ {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Кэш на клиенте: файлы отдаём с уникальными именами,
        # так что смело помечаем immutable на 30 дней.
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # ── Swagger / OpenAPI ────────────────────────────────────────
    location = /docs         { proxy_pass http://127.0.0.1:8000; }
    location = /redoc        { proxy_pass http://127.0.0.1:8000; }
    location = /openapi.json { proxy_pass http://127.0.0.1:8000; }
    location = /health       { proxy_pass http://127.0.0.1:8000; }

    # ── Кэш статики Vite (имена файлов содержат хэш) ────────────
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$ {
        try_files $uri =404;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               application/xml text/xml image/svg+xml;
}
